DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_pos
DB_USER=erp_user
DB_PASSWORD=erp_password
JWT_SECRET=change-this-secret-at-least-32-characters-long
JWT_EXPIRATION=3600000
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# BT-004 (security/Flyway):
# true => desactiva usuarios seed no-admin (cajero/almacenero/supervisor) via V15.
# En local/QA mantener false para conservar cuentas de prueba.
HARDEN_DEFAULT_SEED_USERS=false

# true => tambien desactiva el usuario seed admin via V15.
# Mantener false salvo hardening explicito de piloto/produccion.
HARDEN_DEFAULT_SEED_USERS_INCLUDE_ADMIN=false

