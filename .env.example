DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_pos
DB_USER=erp_user
DB_PASSWORD=erp_password
JWT_SECRET=change-this-secret-at-least-32-characters-long
JWT_EXPIRATION=3600000
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# BT-004 (security/Flyway):
# true => desactiva usuarios seed no-admin (cajero/almacenero/supervisor) via V15.
# En local/QA mantener false para conservar cuentas de prueba.
HARDEN_DEFAULT_SEED_USERS=false

# true => tambien desactiva el usuario seed admin via V15.
# Mantener false salvo hardening explicito de piloto/produccion.
HARDEN_DEFAULT_SEED_USERS_INCLUDE_ADMIN=false

# Ecommerce public image URL policy (backend admin/readiness/publication).
# Separar multiples dominios con coma. Mantener alineado con STOREFRONT_IMAGE_ALLOWED_DOMAINS.
ECOMMERCE_PUBLIC_IMAGE_ALLOWED_DOMAINS=

# Ecommerce image upload storage MVP. Mantener none hasta configurar S3 privado + CloudFront.
ECOMMERCE_IMAGE_STORAGE_PROVIDER=none
AWS_REGION=us-east-1
ECOMMERCE_IMAGE_S3_BUCKET=
ECOMMERCE_IMAGE_S3_PREFIX=
ECOMMERCE_IMAGE_PUBLIC_BASE_URL=
ECOMMERCE_IMAGE_CACHE_CONTROL=public, max-age=31536000, immutable
ECOMMERCE_IMAGE_MAX_SIZE_BYTES=5242880
ECOMMERCE_IMAGE_MAX_WIDTH=6000
ECOMMERCE_IMAGE_MAX_HEIGHT=6000
ECOMMERCE_IMAGE_MULTIPART_MAX_FILE_SIZE=10MB
ECOMMERCE_IMAGE_MULTIPART_MAX_REQUEST_SIZE=10MB
