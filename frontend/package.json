{
  "name": "erp-pos-frontend",
  "version": "0.0.1",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.3",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "10.9.9",
      "onFail": "error"
    }
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "e2e:install": "playwright install chromium",
    "e2e:auth": "playwright test e2e/setup/auth.setup.ts --grep @no-write",
    "e2e:no-write": "playwright test --grep @no-write",
    "e2e:no-write:headed": "playwright test --grep @no-write --headed --workers=1",
    "e2e:no-write:ci": "playwright test --grep @no-write --workers=1",
    "e2e:billing-series:ci": "playwright test e2e/specs/billing-series-concurrency.spec.ts --workers=1",
    "e2e:report": "playwright show-report e2e/playwright-report"
  },
  "dependencies": {
    "@angular/animations": "20.3.33",
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/forms": "20.3.33",
    "@angular/platform-browser": "20.3.33",
    "@angular/platform-browser-dynamic": "20.3.33",
    "@angular/router": "20.3.33",
    "rxjs": "7.8.1",
    "tslib": "2.6.3",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.39",
    "@angular/cli": "20.3.39",
    "@angular/compiler-cli": "20.3.33",
    "@playwright/test": "^1.61.1",
    "@types/jasmine": "5.1.15",
    "jasmine-core": "5.2.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "5.9.3"
  }
}
