{
  "name": "erp-pos-frontend",
  "version": "0.0.1",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.3",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "10.9.9",
      "onFail": "error"
    }
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "e2e:install": "playwright install chromium",
    "e2e:auth": "node e2e/qa/run-qa.mjs",
    "e2e:no-write": "node e2e/qa/run-qa.mjs",
    "e2e:no-write:headed": "node e2e/qa/run-qa.mjs --headed",
    "e2e:no-write:ci": "node e2e/qa/run-qa.mjs",
    "e2e:billing-series:ci": "playwright test e2e/specs/billing-series-concurrency.spec.ts --workers=1",
    "e2e:internal-note:ci": "playwright test e2e/specs/internal-note.no-write.spec.ts --project=chromium --workers=1 --retries=0 --grep @internal-note-ci --reporter=line",
    "e2e:report": "playwright show-report e2e/playwright-report"
  },
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "pdfmake": "0.3.13",
    "rxjs": "7.8.1",
    "tslib": "2.6.3",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "@playwright/test": "^1.61.1",
    "@types/jasmine": "5.1.15",
    "@types/pdfmake": "0.3.3",
    "jasmine-core": "5.2.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "5.9.3"
  }
}
