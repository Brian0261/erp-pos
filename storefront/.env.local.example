# URL server-side de Storefront API. No exponer al navegador.
STOREFRONT_API_BASE_URL=http://localhost:8080

# URL publica del Storefront para canonicals y sitemap.xml.
STOREFRONT_PUBLIC_BASE_URL=http://localhost:3000

# Mantener false hasta aprobar dominio productivo e indexacion publica.
STOREFRONT_INDEXING_ENABLED=false
