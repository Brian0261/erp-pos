# URL server-side de Storefront API. No exponer al navegador.
STOREFRONT_API_BASE_URL=http://localhost:8080

# URL publica del Storefront para canonicals y sitemap.xml.
# Debe ser un dominio real antes de activar indexacion.
# No usar localhost, 127.0.0.1 ni dominios example/test para publicacion.
STOREFRONT_PUBLIC_BASE_URL=http://localhost:3000

# Mantener false hasta aprobar dominio productivo e indexacion publica.
# No activar con datos smoke/test publicados.
STOREFRONT_INDEXING_ENABLED=false

# Dominios https permitidos para renderizar imagenes publicas ecommerce.
# Separar multiples dominios con coma. Mantener vacio hasta elegir storage/CDN.
# Si backend usa ECOMMERCE_IMAGE_PUBLIC_BASE_URL, agregar aqui el mismo host CloudFront/CDN.
# No usar localhost, IPs privadas ni dominios example/test.
STOREFRONT_IMAGE_ALLOWED_DOMAINS=
